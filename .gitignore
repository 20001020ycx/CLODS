# Per-bug evaluation progress (lightweight) IS tracked in this repo so multiple agents
# can coordinate and resume. Heavy, reproducible artifacts are ignored:
#   - source/      : anonymized source trees (rebuild from anonymization_map.json +
#                    deps-fix.patch + pre_fix_commit; see METHODOLOGY.md §resume)
#   - logs/        : symptom logs (can be huge); the published example's small log is kept
#   - repos/       : per-bug scratch clones of the system repo
evaluations/**/source/
evaluations/**/logs/*
!evaluations/EXAMPLE/bug-1/logs/symptom.log
evaluations/**/private/symptom.orig.log
evaluations/**/private/merged.orig.log
evaluations/**/logs/repro.log
repos/

# Shared per-system production logs (GB-scale noise/context logs that a bug's
# reproduction log is merged into at M3; regenerable from the cluster setup under
# agent-dev/case-study). Never commit — multi-GB.
production-logs/

# Build / editor noise
*.class
target/
build/
.gradle/
.idea/
.vscode/
__pycache__/
*.pyc
*.orig.log
.DS_Store